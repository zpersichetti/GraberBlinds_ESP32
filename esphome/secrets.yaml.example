# Copy this file to  secrets.yaml  (which is gitignored) and fill in your values.
# In the ESPHome add-on, these live in /config/esphome/secrets.yaml.

wifi_ssid: "your-2.4GHz-ssid"        # ESP32 is 2.4 GHz only — do NOT use a 5 GHz SSID
wifi_password: "your-wifi-password"

# ESPHome API encryption key — generate in the ESPHome dashboard (or reuse your device's).
api_key: "base64-key-from-esphome=="

# Fallback hotspot password (any 8+ characters).
ap_password: "changeme1234"
